---
/**
 * The clearing. One canvas, a quiet overlay, and small ways out.
 */
import site from '../../site.config.mjs';
import Head from '../components/Head.astro';
import { assetPath } from '../../scripts/identity-model.mjs';
import '../styles/clearing.css';
---
<!doctype html>
<html lang={site.identity.defaultLanguage}>
  <head>
    <Head pathname={Astro.url.pathname} />
  </head>
  <body class="clearing-body">
    <a class="skip" href="#verbs">Skip to the verbs</a>
    <canvas
      class="clearing"
      data-clearing
      role="img"
      aria-label="A night clearing in the woods with a small settlement of stacked rooms, lit windows, things on the ground and wandering creatures. It is drawn live from everything visitors have left."
    ></canvas>

    <div class="overlay" data-overlay data-mode="look">
      <div class="top">
        <header class="brand">
          <img src={assetPath(site, '/wordmark.svg')} alt={site.title} width="90" height="30" />
        </header>
        <p class="count" data-count aria-live="polite"></p>
      </div>

      <div class="stage">
        <section class="chalk" data-chalk hidden aria-label="Chalk the slate">
          <p class="chalk-title">chalk the slate. cells never clear.</p>
          <div class="chalk-grid" data-chalk-grid role="group" aria-label="Slate cells, bottom row is the ground"></div>
          <div class="chalk-tools">
            <button type="button" class="chalk-colour chalk-colour--white" data-chalk-white aria-pressed="true">white</button>
            <button type="button" class="chalk-colour chalk-colour--ember" data-chalk-ember aria-pressed="false">ember</button>
            <span class="chalk-count" data-chalk-count></span>
            <button type="button" class="helper" data-chalk-send disabled>chalk it</button>
            <button type="button" class="helper helper--quiet" data-chalk-cancel>never mind</button>
          </div>
        </section>
        <p class="whisper" data-whisper aria-live="polite" role="status"></p>
      </div>

      <div class="bottom">
      <div class="helpers">
        <div class="hand" data-hand hidden></div>
        <button type="button" class="helper" data-choose hidden>let the clearing choose</button>
        <button type="button" class="helper" data-nearest hidden>shoo whichever is nearest</button>
      </div>
      <section class="verbs" id="verbs" aria-label="What you can do here">
        <button type="button" class="verb" data-verb="build" data-label="Build a room" aria-pressed="false">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg>
          <span>build</span><em data-dots></em>
        </button>
        <button type="button" class="verb" data-verb="place" data-label="Place a thing" aria-pressed="false">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 20h10"/><path d="M12 20v-7"/><path d="M12 13c-3.5 0-6-2.5-6-6 3.5 0 6 2.5 6 6Z"/><path d="M12 11c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6Z"/></svg>
          <span>place</span><em data-dots></em>
        </button>
        <button type="button" class="verb" data-verb="chalk" data-label="Chalk a slate" aria-pressed="false">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m4 20 1-4L16.5 4.5a2.1 2.1 0 0 1 3 3L8 19l-4 1Z"/><path d="m14 7 3 3"/></svg>
          <span>chalk</span><em data-dots></em>
        </button>
        <button type="button" class="verb" data-verb="nudge" data-label="Nudge a creature" aria-pressed="false">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 11V6a2 2 0 0 0-4 0v1"/><path d="M14 10V4a2 2 0 0 0-4 0v2"/><path d="M10 10.5V6a2 2 0 0 0-4 0v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.9-5.9-2.4L3.5 16a2 2 0 0 1 2.8-2.8L8 15"/></svg>
          <span>nudge</span><em data-dots></em>
        </button>
        <button type="button" class="verb verb--wave" data-verb="wave" data-label="Wave to whoever is here" aria-pressed="false">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2v4"/><path d="m5 5 2.5 2.5"/><path d="m19 5-2.5 2.5"/><path d="M9 21h6"/><path d="M8 12a4 4 0 1 1 8 0c0 2-1 3-2 4v2h-4v-2c-1-1-2-2-2-4Z"/></svg>
          <span>wave</span><em data-dots></em>
        </button>
      </section>

      <footer class="small">
        <button type="button" class="small-link" data-about-open aria-haspopup="dialog">what is this?</button>
        <a href={assetPath(site, '/terms/')}>Terms</a>
        <a href={assetPath(site, '/privacy/')}>Privacy and data</a>
        <a href={assetPath(site, '/impressum/')}>Impressum</a>
        <a href="https://wolfsblvt.works/" rel="noopener">A Wolfsblvt Works product</a>
      </footer>
      </div>
    </div>

    <dialog class="about" data-about aria-labelledby="about-title">
      <h1 id="about-title">Irrwisch</h1>
      <p>A small clearing in the woods that exists only because people came by. An Irrwisch is a will-o'-the-wisp: a little light wandering the woods at night. Tonight that is you.</p>
      <p>When you arrived, a figure with a lantern walked in and a window lit up. It stays lit for a while, then settles to an ember that never goes out. Before you leave you can build one room, place one thing, chalk a few cells on a slate, shoo one of the little ones a step, and wave to whoever else is here.</p>
      <p>Nothing you add can be taken back, and nobody can tear down what others built. The place is whatever everyone made of it. It changes a little while nobody is watching.</p>
      <p class="about-quiet">No account, no cookies, nothing stored on your device. Everything left here is anonymous and public. Seen something on a slate that should not be there? <a href="https://contact.wolfsblvt.works/" rel="noopener">Tell me</a> and I will wipe it.</p>
      <p class="about-links">
        <a href={assetPath(site, '/terms/')}>Terms</a>
        <a href={assetPath(site, '/privacy/')}>Privacy and data</a>
        <a href={assetPath(site, '/impressum/')}>Impressum</a>
        <a href="https://wolfsblvt.works/" rel="noopener">A Wolfsblvt Works product</a>
      </p>
      <form method="dialog"><button type="submit" class="helper">back to the clearing</button></form>
    </dialog>

    <noscript>
      <div class="noscript">
        <p>Irrwisch is a small clearing in the woods that only exists because people came by. It is drawn live in your browser, which needs JavaScript. The ground is still there without it; you just cannot see it tonight.</p>
      </div>
    </noscript>

    <script src="../client/main.ts"></script>
  </body>
</html>
