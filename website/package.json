{
  "name": "lichtung-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "npm run build:site && wrangler dev --config wrangler.jsonc --port 8787",
    "check": "astro check && tsc -p tsconfig.worker.json --noEmit",
    "assets:generate": "node scripts/generate-site-assets.mjs",
    "build:site": "npm run assets:generate && astro build",
    "build": "npm run build:site",
    "test:rules": "node --test \"tests/**/*.test.ts\"",
    "test": "npm run check && npm run test:rules && npm run build",
    "preview": "wrangler dev --config wrangler.jsonc --port 8787",
    "check:publish": "node scripts/check-publish.mjs && npm run build && node scripts/check-output.mjs",
    "deploy": "npm run check:publish && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.7",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261106.1",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  }
}
